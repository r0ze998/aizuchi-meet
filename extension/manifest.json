{
  "manifest_version": 3,
  "name": "Aizuchi – Meet英会話サポート",
  "short_name": "Aizuchi",
  "version": "0.1.0",
  "description": "Google Meet タブの音声だけを取得し、日本語訳と短い英語の返答候補を表示します。自動発話やチャット送信はしません。",
  "key": "",
  "minimum_chrome_version": "139",
  "permissions": ["tabCapture", "offscreen", "sidePanel", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": {
    "default_title": "Aizuchi: このタブで使う（サイドパネルを開く）",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Aizuchi をこのタブで呼び出す"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
