# Copy to relay/.env (chmod 600). Never commit. Never paste keys into chat.
UPSTREAM=mock            # mock | anthropic
#ANTHROPIC_API_KEY=       # only read by the relay process
REPLY_MODEL=claude-opus-5-5     # or claude-haiku-5-5 for lower latency/cost
#TRANSLATE_MODEL=claude-haiku-5-5
REPLY_EFFORT=low
MAX_SESSION_USD=1.00
MAX_REQ_PER_MIN=30
RELAY_PORT=47231
#RELAY_LOG_BODIES=0
#REPLY_FALLBACKS=1
